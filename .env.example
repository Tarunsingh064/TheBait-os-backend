NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://localhost:27017/agency-os

# Use long random values in production, e.g. `openssl rand -hex 64`
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret

# Comma-separated list of allowed frontend origins, e.g. https://app.youragency.com
CORS_ORIGINS=http://localhost:3000

# From Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me_razorpay_key_secret
# From Razorpay Dashboard > Settings > Webhooks > (the secret you set when adding the webhook URL)
RAZORPAY_WEBHOOK_SECRET=replace_me_razorpay_webhook_secret

# Create these once in Razorpay Dashboard > Subscriptions > Plans, paste the IDs here
RAZORPAY_PLAN_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_YEARLY=plan_xxxxxxxxxxxx

# Free at huggingface.co/settings/tokens — used server-side for meeting summaries
HF_API_TOKEN=replace_me_hugging_face_token

# From console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=replace_me_google_client_id
GOOGLE_CLIENT_SECRET=replace_me_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Where to redirect after a successful OAuth login
FRONTEND_URL=http://localhost:3000
